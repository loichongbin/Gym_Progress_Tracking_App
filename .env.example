# ─────────────────────────────────────────────────────────────────────────────
# Spotter environment variables. Copy to .env.local and fill in.
# NEVER commit real values (.env* files are git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# Public — safe to expose to the browser (protected by Row Level Security).
# Supabase Dashboard → Project Settings → API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). The legacy "anon" JWT key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only secrets — used by /api/account (account deletion) and the story clean-up cron.
# The secret key (sb_secret_…) or the legacy "service_role" key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional: absolute site URL used for auth email redirects during server rendering.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
